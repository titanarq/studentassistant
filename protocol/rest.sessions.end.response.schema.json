{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/titanarq/studentassistant/protocol/rest.sessions.end.response.schema.json",
  "title": "rest.sessions.end.response",
  "description": "POST /api/sessions/{id}/end response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "status",
    "ended_at_ms"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "status": {
      "const": "ended"
    },
    "ended_at_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Backend clock, Unix epoch ms."
    }
  }
}
