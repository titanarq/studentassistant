{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/titanarq/studentassistant/protocol/rest.topics.create.response.schema.json",
  "title": "rest.topics.create.response",
  "description": "POST /api/subjects/{subject_id}/topics response: the created topic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_id",
    "subject_id",
    "name"
  ],
  "properties": {
    "topic_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "open_session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "The session still open on this topic, if any; the client resumes it instead of starting one."
    }
  }
}
