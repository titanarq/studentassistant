#!/usr/bin/env bash
# The mechanism's interpreter, with one change (host-side workaround for titanarq/agent-os#27):
# `python -m agent_os.issues ...` runs `issues_main.py ...` instead, which installs the cheap board
# lookups (`board_lookup.py`) before the same `main()` runs. Every other invocation is passed to
# the real interpreter untouched.
#
# Point `AGENT_OS_PYTHON` at this file and every mechanism caller uses it: the guard's own
# subprocesses (`agent_os_python()` reads the variable), the drivers in agent_os/bin/ (they
# resolve and EXPORT it, so planner/refiner/validator/worker shells inherit it) and the prompts
# (they spell `"$AGENT_OS_PYTHON" -m agent_os.issues`). Set by the scripts/ shims, whose
# `agent_guard.py` is the guard unit's ExecStart, so no systemd drop-in is needed. Remove with this
# directory once agent-os#27 is fixed and the subtree is pulled.
here=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
real=${AGENT_OS_REAL_PYTHON:-$here/../../agent_os/.venv/bin/python}
# Never ourselves (AGENT_OS_REAL_PYTHON pointed back here), never a missing venv.
if [ "$(realpath "$real" 2>/dev/null)" = "$(realpath "${BASH_SOURCE[0]}")" ] || [ ! -x "$real" ]; then
  real=python3
fi
if [ "${1:-}" = -m ] && [ "${2:-}" = agent_os.issues ]; then
  shift 2
  exec "$real" "$here/issues_main.py" "$@"
fi
exec "$real" "$@"
