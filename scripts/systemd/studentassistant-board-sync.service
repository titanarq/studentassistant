[Unit]
Description=studentassistant board sync (status:* labels -> Project 3 Status column; workaround for titanarq/agent-os#14)

[Service]
Type=oneshot
WorkingDirectory=/home/titan/projects/studentassistant
Environment="PATH=/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python3 /home/titan/projects/studentassistant/scripts/board_sync.py
# workaround titanarq/agent-os#18 (decision A on #1, 2026-09-24): clears a finished worker's
# stale scratchpad diary once its issue is closed, so `worker_task.sh start` stops refusing the
# next dispatch. Idempotent and silent when there is nothing to do; see
# scripts/clean_stale_workers_if_closed.sh and docs/runbooks/operations.md.
ExecStart=/home/titan/projects/studentassistant/scripts/clean_stale_workers_if_closed.sh
